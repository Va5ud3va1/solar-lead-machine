/* Root Variables */
:host {
  --bg-primary: #0a0e27;
  --bg-secondary: #1a1f3a;
  --bg-tertiary: #252d4a;
  --text-primary: #e0e0e0;
  --text-secondary: #b0b0b0;
  --border-color: #404060;
  --neon-green: #00ff88;
  --neon-cyan: #00d4ff;
  --neon-gold: #ffd700;
  --neon-red: #ff1744;
}

.kanban-container {
  background: var(--bg-primary);
  color: var(--text-primary);
  padding: 2rem;
  min-height: 100vh;
  overflow-x: auto;
  position: relative;
}

/* Error Banner */
.error-banner {
  background: rgba(255, 23, 68, 0.2);
  border: 1px solid var(--neon-red);
  border-radius: 8px;
  padding: 1rem;
  margin-bottom: 1.5rem;
  display: flex;
  justify-content: space-between;
  align-items: center;
  color: var(--neon-red);
}

.error-banner button {
  background: var(--neon-red);
  color: var(--bg-primary);
  border: none;
  padding: 0.5rem 1rem;
  border-radius: 4px;
  cursor: pointer;
  font-weight: 600;
  transition: all 0.3s ease;
}

.error-banner button:hover {
  opacity: 0.8;
}

/* Loading Container */
.loading-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 400px;
  gap: 1rem;
}

.spinner {
  border: 4px solid var(--border-color);
  border-top: 4px solid var(--neon-green);
  border-radius: 50%;
  width: 48px;
  height: 48px;
  animation: spin 1s linear infinite;
}

@keyframes spin {
  0% {
    transform: rotate(0deg);
  }
  100% {
    transform: rotate(360deg);
  }
}

.loading-container p {
  color: var(--text-secondary);
  font-size: 1rem;
}

/* Main Content */
.main-content {
  animation: fadeIn 0.3s ease;
}

@keyframes fadeIn {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

/* Updating Overlay */
.updating-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(10, 14, 39, 0.7);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  z-index: 999;
  backdrop-filter: blur(2px);
}

.updating-overlay .spinner {
  border-top-color: var(--neon-cyan);
}

.updating-overlay p {
  color: var(--neon-cyan);
  margin-top: 1rem;
  font-size: 1rem;
}

/* Header Section */
.kanban-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 2rem;
  padding-bottom: 1.5rem;
  border-bottom: 2px solid var(--border-color);
}

.header-content h1 {
  margin: 0;
  font-size: 2.5rem;
  font-weight: 700;
  background: linear-gradient(
    135deg,
    var(--neon-green),
    var(--neon-cyan)
  );
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

.header-content p {
  margin: 0.5rem 0 0 0;
  color: var(--text-secondary);
  font-size: 0.95rem;
}

.admin-badge {
  background: var(--bg-secondary);
  border: 2px solid var(--neon-cyan);
  color: var(--neon-cyan);
  padding: 0.5rem 1rem;
  border-radius: 20px;
  font-size: 0.9rem;
  font-weight: 600;
}

/* Metrics Grid */
.metrics-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
  gap: 1.5rem;
  margin-bottom: 3rem;
}

.metric-card {
  background: var(--bg-secondary);
  padding: 1.5rem;
  border-radius: 12px;
  border-left: 4px solid var(--neon-green);
  transition: all 0.3s ease;
}

.metric-card:hover {
  transform: translateY(-4px);
  box-shadow: 0 8px 24px rgba(0, 255, 136, 0.15);
}

.metric-card:nth-child(2) {
  border-left-color: var(--neon-green);
}

.metric-card:nth-child(3) {
  border-left-color: var(--neon-cyan);
}

.metric-card:nth-child(4) {
  border-left-color: var(--neon-gold);
}

.metric-value {
  font-size: 2.5rem;
  font-weight: 700;
  color: var(--text-primary);
  margin-bottom: 0.5rem;
}

.metric-label {
  font-size: 0.75rem;
  font-weight: 600;
  letter-spacing: 0.1em;
  color: var(--text-secondary);
  text-transform: uppercase;
}

/* Kanban Board Section */
.kanban-board {
  background: var(--bg-secondary);
  border-radius: 16px;
  padding: 2rem;
  border: 1px solid var(--border-color);
}

.board-title {
  margin: 0 0 1.5rem 0;
  font-size: 1.5rem;
  font-weight: 600;
}

/* Columns Container */
.columns-container {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
  gap: 1.5rem;
  overflow-x: auto;
  padding-bottom: 1rem;
}

/* Kanban Column */
.kanban-column {
  background: var(--bg-tertiary);
  border-radius: 12px;
  border: 1px solid var(--border-color);
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.column-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 1rem 1.25rem;
  background: var(--bg-secondary);
  border-top: 3px solid var(--neon-green);
  border-bottom: 1px solid var(--border-color);
}

.column-header h3 {
  margin: 0;
  font-size: 1.1rem;
  font-weight: 600;
}

.column-count {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 32px;
  height: 32px;
  border-radius: 50%;
  color: var(--bg-primary);
  font-weight: 700;
  font-size: 0.9rem;
}

/* Drop Zone */
.drop-zone {
  flex: 1;
  padding: 1rem;
  min-height: 400px;
  display: flex;
  flex-direction: column;
  gap: 1rem;
  transition: opacity 0.3s ease;
}

.drop-zone.disabled {
  opacity: 0.6;
  pointer-events: none;
}

.drop-zone.cdk-drop-list-dragging .cdk-drag:not(.cdk-drag-placeholder) {
  transition: transform 150ms cubic-bezier(0, 0, 0.2, 1);
}

/* Lead Card */
.lead-card {
  background: var(--bg-secondary);
  border: 1px solid var(--border-color);
  border-left: 4px solid var(--neon-green);
  border-radius: 8px;
  padding: 1rem;
  cursor: grab;
  transition: all 0.3s ease;
}

.lead-card:hover {
  box-shadow: 0 8px 16px rgba(0, 255, 136, 0.2);
  border-color: var(--border-color);
}

.lead-card:active {
  cursor: grabbing;
}

.lead-card.dragging {
  opacity: 0.6;
  cursor: not-allowed;
}

.lead-card.cdk-drag-preview {
  box-shadow: 0 12px 32px rgba(0, 255, 136, 0.3);
  border-color: var(--neon-green);
  transform: scale(1.02);
}

.lead-card.cdk-drag-animating {
  transition: transform 250ms cubic-bezier(0, 0, 0.2, 1);
}

/* Card Header */
.card-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 0.75rem;
  gap: 0.75rem;
}

.card-header h4 {
  margin: 0;
  font-size: 0.95rem;
  font-weight: 600;
  flex: 1;
}

.status-badge {
  padding: 0.25rem 0.75rem;
  border-radius: 4px;
  font-size: 0.7rem;
  font-weight: 700;
  color: var(--bg-primary);
  white-space: nowrap;
  text-transform: uppercase;
}

/* Card Body */
.card-body {
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
  margin-bottom: 0.75rem;
  padding-bottom: 0.75rem;
  border-bottom: 1px solid var(--border-color);
}

.card-field {
  display: flex;
  justify-content: space-between;
  font-size: 0.85rem;
}

.field-label {
  color: var(--text-secondary);
  font-weight: 500;
}

.field-value {
  color: var(--text-primary);
  font-weight: 600;
  word-break: break-all;
}

/* Card Actions */
.card-actions {
  display: flex;
  gap: 0.5rem;
  justify-content: flex-end;
}

.action-btn {
  background: transparent;
  border: 1px solid var(--border-color);
  color: var(--text-secondary);
  padding: 0.4rem 0.6rem;
  border-radius: 4px;
  cursor: pointer;
  font-size: 0.85rem;
  transition: all 0.2s ease;
}

.action-btn:hover {
  background: var(--bg-tertiary);
  border-color: var(--neon-cyan);
  color: var(--neon-cyan);
}

/* Empty State */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  flex: 1;
  min-height: 200px;
  color: var(--text-secondary);
  text-align: center;
}

.empty-state p {
  margin: 0;
  font-size: 1rem;
  font-weight: 500;
}

.empty-state small {
  display: block;
  margin-top: 0.5rem;
  font-size: 0.85rem;
  opacity: 0.7;
}

/* Responsive Design */
@media (max-width: 1200px) {
  .columns-container {
    grid-template-columns: repeat(2, 1fr);
  }
}

@media (max-width: 768px) {
  .kanban-container {
    padding: 1rem;
  }

  .metrics-grid {
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
  }

  .kanban-board {
    padding: 1rem;
  }

  .columns-container {
    grid-template-columns: 1fr;
  }

  .drop-zone {
    min-height: 300px;
  }
}
/* ---------- Lead Drawer ---------- */

.lead-drawer{

position:fixed;

top:0;

right:-420px;

width:400px;

height:100vh;

background:#111827;

border-left:1px solid #374151;

padding:24px;

transition:right .3s ease;

z-index:999;

overflow:auto;

box-shadow:-6px 0 20px rgba(0,0,0,.35);

}

.lead-drawer.open{

right:0;

}

.drawer-header{

display:flex;

justify-content:space-between;

align-items:center;

margin-bottom:24px;

}

.drawer-header h2{

margin:0;

color:#fff;

}

.drawer-body p{

margin:14px 0;

color:#e5e7eb;

}

.drawer-body strong{

display:inline-block;

width:90px;

color:#9ca3af;

}

