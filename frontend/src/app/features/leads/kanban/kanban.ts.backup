import { Component, OnInit, OnDestroy, ChangeDetectorRef } from '@angular/core';
import { CommonModule } from '@angular/common';
import { CdkDragDrop, DragDropModule } from '@angular/cdk/drag-drop';
import { Subject } from 'rxjs';
import { takeUntil } from 'rxjs/operators';
import { LeadService, Lead } from '../../../core/services/lead';

interface Column {
  id: string;
  title: string;
  status: string;
  count: number;
  accentColor: string;
}

@Component({
  selector: 'app-kanban',
  standalone: true,
  imports: [CommonModule, DragDropModule],
  templateUrl: './kanban.html',
  styleUrls: ['./kanban.css'],
})
export class KanbanComponent implements OnInit, OnDestroy {
  leads: Lead[] = [];
  columns: Column[] = [];
  metrics = {
    totalLeads: 0,
    newLeads: 0,
    contacted: 0,
    won: 0,
  };
  loading = true;
  error = '';
  updating = false;

  private destroy$ = new Subject<void>();

  constructor(
    private leadService: LeadService,
    private cdr: ChangeDetectorRef
  ) {}

  ngOnInit(): void {
    this.loadLeads();
  }

  loadLeads(): void {
    this.loading = true;
    this.leadService.getAllLeads()
      .pipe(takeUntil(this.destroy$))
      .subscribe({
        next: (data: Lead[]) => {
          console.log('✅ Leads received:', data);
          this.leads = data;
          this.initializeColumns();
          this.initializeColumns();
      console.log("Columns initialized:", this.columns);
          this.updateMetrics();
          this.loading = false;
          this.cdr.detectChanges();
        },
        error: (err: any) => {
          console.error('❌ Error loading leads:', err);
          this.error = 'Failed to load leads';
          this.loading = false;
          this.cdr.detectChanges();
        },
      });
  }

  initializeColumns(): void {
    this.columns = [
      {
        id: 'new',
        title: 'New',
        status: 'NEW',
        count: 0,
        accentColor: '#00ff88', // Neon green
      },
      {
        id: 'contacted',
        title: 'Contacted',
        status: 'CONTACTED',
        count: 0,
        accentColor: '#00d4ff', // Neon cyan
      },
      {
        id: 'won',
        title: 'Won',
        status: 'WON',
        count: 0,
        accentColor: '#ffd700', // Neon gold
      },
      {
        id: 'lost',
        title: 'Lost',
        status: 'LOST',
        count: 0,
        accentColor: '#ff1744', // Neon red
      },
    ];

    this.updateColumnCounts();
  }

  updateColumnCounts(): void {
    this.columns.forEach((col) => {
      col.count = this.leads.filter((lead) => lead.status === col.status).length;
    });
  }

  getLeadsByStatus(status: string): Lead[] {
    return this.leads.filter((lead) => lead.status === status);
  }

  drop(event: CdkDragDrop<Lead[]>, newStatus: string): void {
    if (event.previousContainer === event.container) {
      // Reordered within same column - no status change
      return;
    }

    // Get the lead being dropped
    const lead = event.previousContainer.data[event.previousIndex];
    const oldStatus = lead.status;

    // Prevent if status didn't change
    if (oldStatus === newStatus) {
      return;
    }

    // Update lead status in memory (optimistic update)
    const leadIndex = this.leads.findIndex((l) => l.id === lead.id);
    if (leadIndex !== -1) {
      this.leads[leadIndex].status = newStatus;
    }

    // Update column counts and metrics
    this.updateColumnCounts();
    this.updateMetrics();
    this.cdr.detectChanges();

    // Call backend API to persist the change
    this.updating = true;
    const updateData = {
      ...lead,
      status: newStatus,
    };

    this.leadService.updateLeadStatus(lead.id, newStatus)
      .pipe(takeUntil(this.destroy$))
      .subscribe({
        next: (updatedLead: Lead) => {
          console.log(`✅ Lead "${updatedLead.name}" moved to "${newStatus}"`);
          this.updating = false;
          this.cdr.detectChanges();
        },
        error: (err: any) => {
          console.error(`❌ Failed to update lead status:`, err);
          // Revert the change on error
          if (leadIndex !== -1) {
            this.leads[leadIndex].status = oldStatus;
          }
          this.updateColumnCounts();
          this.updateMetrics();
          this.error = 'Failed to update lead status';
          this.updating = false;
          this.cdr.detectChanges();
        },
      });
  }

  updateMetrics(): void {
    this.metrics = {
      totalLeads: this.leads.length,
      newLeads: this.leads.filter((l) => l.status === 'NEW').length,
      contacted: this.leads.filter((l) => l.status === 'CONTACTED').length,
      won: this.leads.filter((l) => l.status === 'WON').length,
    };
  }

  getStatusColor(status: string): string {
    const colorMap: { [key: string]: string } = {
      NEW: '#00ff88',
      CONTACTED: '#00d4ff',
      WON: '#ffd700',
      LOST: '#ff1744',
    };
    return colorMap[status] || '#888';
  }

  ngOnDestroy(): void {
    this.destroy$.next();
    this.destroy$.complete();
  }
}